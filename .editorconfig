# Editor settings shared by every Conker repository; .gitattributes keeps line endings LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,json,yml,yaml,css,html}]
indent_size = 2

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

[*.{patch,diff}]
# Unified diffs need their single-space prefix on empty context lines.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
