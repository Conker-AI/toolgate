# Auto-generated on first API startup if left blank, then written back here.
# This is the owner's own dashboard credential, so it stays readable here on
# purpose. Provider secrets below do not: they are stored as enc:v1: tokens.
TOOLGATE_ADMIN_KEY=

# Install-time vault secret. Leave blank to use the key file named by
# TOOLGATE_VAULT_KEY_FILE (compose puts it on its own volume). Set it only if
# something outside this file supplies it -- a Docker secret, an orchestrator.
# TOOLGATE_VAULT_SECRET=

# Per-install scrypt salt, written on first start. Not a secret.
TOOLGATE_VAULT_SALT=

# Comma-separated browser origins allowed to call the local API.
TOOLGATE_DASHBOARD_ORIGINS=http://localhost:8011,http://127.0.0.1:8011

# Internal read-only service integration. MEMORYGATE_URL is configuration and
# stays in cleartext; the credentials below are encrypted at rest on first start.
MEMORYGATE_URL=http://memorygate-api:8020
MEMORYGATE_READ_KEY=
TOOLGATE_CALLBACK_SECRET=

GITHUB_TOKEN=
RAILWAY_API_KEY=
VERCEL_TOKEN=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=
RESEND_API_KEY=
TAVILY_API_KEY=

# AI tools (ollama_generate) through Pi's tool-text model role. Set both, or neither to keep
# calling Ollama directly. Runtime configuration, never encrypted: supply the key from the
# environment (compose `environment:` or a Docker secret) rather than here. See docs/deployment.md.
# TOOLGATE_PI_URL=http://pi-api:8050
# TOOLGATE_PI_SERVICE_KEY=

# Deployment bootstrap execution key. Supply it from the environment (compose
# `environment:` or a Docker secret) rather than here: startup reads it before
# the vault can decrypt anything, so a value on this line is not encrypted.
# TOOLGATE_BOOTSTRAP_EXECUTION_KEY=
# First-start seed only; defaults to no permissions. Grant specific scopes in the owner interface.
# Existing scope restrictions and revocations always survive restart.
# TOOLGATE_BOOTSTRAP_SCOPES=
